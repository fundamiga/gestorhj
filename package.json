{
  "name": "expedientes-fundamiga",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "electron:dev": "concurrently \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "dist": "npm run build && electron-builder --config.win.signAndEditExecutable=false"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "cloudinary": "^2.10.0",
    "docxtemplater": "^3.69.3",
    "jszip": "^3.10.1",
    "lucide-react": "^1.7.0",
    "next": "^16.2.4",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pizzip": "^3.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "^16.2.4",
    "pdfjs-dist": "^6.1.200",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "com.fundamiga.expedientes",
    "productName": "Expedientes Fundamiga",
    "directories": {
      "output": "release"
    },
    "files": [
      ".next/**/*",
      "public/**/*",
      "electron/**/*",
      "next.config.ts",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/next/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
